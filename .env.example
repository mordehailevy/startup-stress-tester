# ── Backend ──────────────────────────────────────
PORT=4000
MONGODB_URI=mongodb://mongo:27017/startup-stress-tester
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── Gemini (optional, free tier) ─────────────────
# Put your real key in .env only — never commit it, never prefix it with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_DAILY_LIMIT=200
AI_HOURLY_LIMIT_PER_USER=10

# ── Frontend (Vite injects at build time) ────────
VITE_API_URL=http://localhost:4000/api
